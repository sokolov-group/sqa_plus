precond_cce__bab =- einsum('AA,II,JJ,A->IJA', np.identity(nextern), np.identity(ncvs), np.identity(ncvs), e_extern, optimize = einsum_type)
precond_cce__bab += einsum('AA,II,JJ,I->IJA', np.identity(nextern), np.identity(ncvs), np.identity(ncvs), e_cvs, optimize = einsum_type)
precond_cce__bab += einsum('AA,II,JJ,J->IJA', np.identity(nextern), np.identity(ncvs), np.identity(ncvs), e_cvs, optimize = einsum_type)
