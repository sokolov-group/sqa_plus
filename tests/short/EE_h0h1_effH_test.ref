temp  = np.einsum('AB,B,UXYZ->XAYZBU', np.identity(nextern_so), e_extern_so, rdm_ccaa_so, optimize = True)
temp -= np.einsum('AB,Ux,XxYZ->XAYZBU', np.identity(nextern_so), h_aa_so, rdm_ccaa_so, optimize = True)
temp += np.einsum('AB,Yx,UXZx->XAYZBU', np.identity(nextern_so), h_aa_so, rdm_ccaa_so, optimize = True)
temp -= np.einsum('AB,Zx,UXYx->XAYZBU', np.identity(nextern_so), h_aa_so, rdm_ccaa_so, optimize = True)
temp -= np.einsum('AB,iUix,XxYZ->XAYZBU', np.identity(nextern_so), v_caca_so, rdm_ccaa_so, optimize = True)
temp -= 1/2 * np.einsum('AB,YZxy,UXxy->XAYZBU', np.identity(nextern_so), v_aaaa_so, rdm_ccaa_so, optimize = True)
temp += np.einsum('AB,iYix,UXZx->XAYZBU', np.identity(nextern_so), v_caca_so, rdm_ccaa_so, optimize = True)
temp -= np.einsum('AB,iZix,UXYx->XAYZBU', np.identity(nextern_so), v_caca_so, rdm_ccaa_so, optimize = True)
temp -= 1/2 * np.einsum('AB,Uxyz,XyzYZx->XAYZBU', np.identity(nextern_so), v_aaaa_so, rdm_cccaaa_so, optimize = True)
temp += 1/2 * np.einsum('AB,Yxyz,UXxZyz->XAYZBU', np.identity(nextern_so), v_aaaa_so, rdm_cccaaa_so, optimize = True)
temp -= 1/2 * np.einsum('AB,Zxyz,UXxYyz->XAYZBU', np.identity(nextern_so), v_aaaa_so, rdm_cccaaa_so, optimize = True)
